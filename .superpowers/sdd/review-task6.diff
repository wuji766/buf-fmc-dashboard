+ * cruiseInterval     多报警点巡航取景切换间隔
+ */
+window.BUF_CONFIG = {
+  dwell: 300000,
+  minDwell: 180000,
+  maxDwell: 360000,
+  manualRecovery: 60000,
+  cruiseInterval: 20000
+};
